+	private void applyProvisioningExtras(SharedPreferences prefs)
+	{
+		Bundle extras = getIntent().getExtras();
+		if (extras == null || !extras.getBoolean("cc10.prefill", false))
+			return;
+
+		SharedPreferences.Editor editor = prefs.edit();
+		if (extras.containsKey("cc10.label"))
+			editor.putString("bookmark.label", extras.getString("cc10.label", ""));
+		else if (extras.containsKey("cc10.label_b64"))
+			editor.putString("bookmark.label",
+			                 new String(Base64.decode(extras.getString("cc10.label_b64", ""),
+			                                          Base64.DEFAULT),
+			                            StandardCharsets.UTF_8));
+		if (extras.containsKey("cc10.hostname"))
+			editor.putString("bookmark.hostname", extras.getString("cc10.hostname", ""));
+		if (extras.containsKey("cc10.port"))
+			editor.putInt("bookmark.port", extras.getInt("cc10.port", 3389));
+		if (extras.containsKey("cc10.username"))
+			editor.putString("bookmark.username", extras.getString("cc10.username", ""));
+		if (extras.containsKey("cc10.password"))
+			editor.putString("bookmark.password", extras.getString("cc10.password", ""));
+		editor.commit();
+		viewModel.setNewBookmark(true);
+		viewModel.setSettingsChanged(true);
+		getIntent().removeExtra("cc10.prefill");
+	}
